# Copy this file to .env and fill in your Neo4j credentials.

# Bolt connection to Neo4j. Use bolt://localhost:7687 for a local/Docker instance,
# or the neo4j+s://... URI from your AuraDB console.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Logical database name (Neo4j 4+/5). Leave as "neo4j" unless you created another.
NEO4J_DATABASE=neo4j

# OPTIONAL. MovieLens "small" has no cast/director/plot. If you provide a free
# TMDB API key, the seed script enriches movies with real actors, directors and
# plot via the tmdbId in links.csv. Leave empty to skip enrichment.
TMDB_API_KEY=
