# Skopiuj ten plik do .env i wpisz swoje dane dostępowe do Neo4j.

# Połączenie Bolt do Neo4j. Dla lokalnej / dockerowej instancji użyj
# bolt://localhost:7687, dla AuraDB — URI neo4j+s://... z panelu AuraDB.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Nazwa bazy logicznej (Neo4j 4+/5). Zostaw "neo4j", o ile nie utworzyłeś innej.
NEO4J_DATABASE=neo4j

# OPCJONALNE. MovieLens "small" nie zawiera obsady, reżyserów ani opisów.
# Jeśli podasz darmowy klucz API TMDB, skrypt seed wzbogaci filmy o prawdziwych
# aktorów, reżyserów i opis (po tmdbId z links.csv). Puste = pomiń wzbogacanie.
TMDB_API_KEY=
